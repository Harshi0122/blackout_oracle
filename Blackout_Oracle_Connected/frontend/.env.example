# Leave VITE_API_BASE_URL unset for local development: Vite proxies /api to FastAPI.
# Set it to your deployed API URL (without a trailing slash) for a separate deployment.
# VITE_API_BASE_URL=https://api.example.com

# Optional local FastAPI address used by the Vite development proxy.
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_POLL_INTERVAL_MS=5000
